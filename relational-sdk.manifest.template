# Rust server manifest with DCAP RA-TLS attestation
# This manifest configures the server to run inside an SGX enclave with
# remote attestation using DCAP (Data Center Attestation Primitives).

# Use gramine-ratls as the entrypoint to generate RA-TLS credentials before
# launching the actual application. The -P flag writes the private key
# unencrypted (required for rustls to load it).
libos.entrypoint = "{{ entrypoint }}"

loader.log_level = "{{ log_level }}"

# Arguments for gramine-ratls:
# -P: Write private key in plain (unencrypted) PEM format
# /tmp/ra-tls.crt.pem: Output path for the certificate
# /tmp/ra-tls.key.pem: Output path for the private key
# --: Separator before the actual application command
# {{ self_exe }}: The Rust server binary to execute after TLS setup
loader.argv = [
    "gramine-ratls", "-P",
    "/tmp/ra-tls.crt.pem",
    "/tmp/ra-tls.key.pem",
    "--",
    "{{ self_exe }}"
]

loader.env.LD_LIBRARY_PATH = "/lib:{{ arch_libdir }}"
loader.env.HOST = "0.0.0.0"
loader.env.PORT = "8080"

# ========== SECRET PROVISIONING (Gramine key fetch from AVS) ==========
# libsecret_prov_attest.so runs in its constructor before main() and fetches the
# /data encryption key from AVS port 4433 via a mutually-attested TLS session.
# AVS verifies the SGX quote in our RA-TLS cert before releasing the key.
#
# The library is in the Gramine runtime dir which maps to /lib inside the enclave.
# It runs in every process (including gramine-ratls) due to LD_PRELOAD; the second
# run (in relational-sdk after exec) is idempotent — the key is already in the slot.
loader.env.LD_PRELOAD = "/lib/libsecret_prov_attest.so"
loader.env.SECRET_PROVISION_CONSTRUCTOR = "1"
loader.env.SECRET_PROVISION_SET_KEY = "data_key"
# AVS address: host:port of the secret provisioning server. Must be passed at runtime.
# Dev: SECRET_PROVISION_SERVERS=localhost:4433
# Docker/staging: SECRET_PROVISION_SERVERS=avs:4433  (or by Docker service name)
loader.env.SECRET_PROVISION_SERVERS = { passthrough = true }
# CA cert AVS uses for its TLS cert on port 4433 (same as avs-tls.crt, bind-mounted).
# In Docker: -v /opt/iob-micres/secrets/avs-tls.crt:/etc/ssl/certs/avs-ca.crt:ro
loader.env.SECRET_PROVISION_CA_CHAIN_PATH = "/etc/ssl/certs/avs-ca.crt"

# AVS URL for JWT validation (passthrough from container env)
loader.env.AVS_JWKS_URL = { passthrough = true }

# See https://gramine.readthedocs.io/en/stable/performance.html#glibc-malloc-tuning
loader.env.MALLOC_ARENA_MAX = "1"

# For easier debugging - not strictly required to run this workload
loader.env.RUST_BACKTRACE = "full"

fs.mounts = [
    { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
    { path = "{{ arch_libdir }}", uri = "file:{{ arch_libdir }}" },
    # tmpfs mount for RA-TLS certificate and key generation
    { path = "/tmp", type = "tmpfs" },
    # gramine-ratls binary location (passed via -Dentrypoint)
    { path = "{{ entrypoint }}", uri = "file:{{ entrypoint }}" },
    # Application directory mount (for self_exe binary)
    # In Docker: app_dir=/app, native: app_dir=. (current directory)
    { path = "{{ app_dir }}", uri = "file:{{ app_dir }}" },

    # ========== DNS RESOLUTION FOR NETWORK ACCESS ==========
    # Required for connecting to external RPC endpoints (Solana, etc.)
    { path = "/etc/resolv.conf", uri = "file:/etc/resolv.conf" },
    { path = "/etc/hosts", uri = "file:/etc/hosts" },
    { path = "/etc/nsswitch.conf", uri = "file:/etc/nsswitch.conf" },
    { path = "/etc/ssl/certs", uri = "file:/etc/ssl/certs" },
    { path = "/usr/share/ca-certificates", uri = "file:/usr/share/ca-certificates" },
    { path = "/etc/ca-certificates.conf", uri = "file:/etc/ca-certificates.conf" },

    # ========== ENCRYPTED PERSISTENT STORAGE ==========
    # All persistent state MUST live under /data
    # - Files are encrypted on the host filesystem
    # - Files are transparently decrypted inside the enclave
    # - Encryption key is provisioned by AVS at startup via Gramine secret provisioning
    #   (libsecret_prov_attest.so fetches a 16-byte AES-GCM key from AVS port 4433,
    #    verifies the AVS TLS cert with SECRET_PROVISION_CA_CHAIN_PATH, and writes it
    #    to the Gramine key slot named "data_key" before this mount is accessed)
    # - Using a provisioned key allows data to survive hardware changes and code updates
    #
    # The Rust application uses normal filesystem I/O.
    # DO NOT implement crypto in Rust for storage - Gramine owns all at-rest encryption.
    { path = "/data", uri = "file:{{ data_dir }}", type = "encrypted", key_name = "data_key" },
]

# SGX configuration - DCAP attestation is mandatory
# sgx.debug: Set via SGX_DEBUG env var (default: false for production security)
# - true: Allow debugging (NEVER use in production - exposes enclave memory!)
# - false: Production mode (recommended)
sgx.debug = {{ 'true' if env.get('SGX_DEBUG', '0') == '1' else 'false' }}
sgx.enclave_size = "4G"
sgx.remote_attestation = "{{ ra_type }}"
sgx.isvprodid = {{ isvprodid }}
sgx.isvsvn = {{ isvsvn }}
# EDMM (per-page W→RX for the wasmtime JIT, src/drt/runtime.rs) needs an
# EDMM-capable SGX driver, which this host's lacks — keep it + use_exinfo off.
sgx.edmm_enable = false
sgx.use_exinfo = false
sgx.preheat_enclave = false

sgx.trusted_files = [
    "file:{{ self_exe }}",
    "file:{{ gramine.runtimedir() }}/",
    "file:{{ arch_libdir }}/",
    "file:{{ entrypoint }}",
]

# Files that may change between runs (DNS config, TLS root CAs).
# These must be "allowed" so the enclave can resolve hostnames and verify
# TLS certificates when connecting to external services (e.g. Solana RPC).
sgx.allowed_files = [
    "file:/etc/resolv.conf",
    "file:/etc/hosts",
    "file:/etc/nsswitch.conf",
    "file:/etc/ssl/certs/",
    "file:/usr/share/ca-certificates/",
    "file:/etc/ca-certificates.conf",
]

# The maximum number of threads in a single process needs to be declared in advance.
# You need to account for:
# - one main thread
# - the tokio worker threads
# - any threads and threadpools you might be starting
# - helper threads internal to Gramine - see:
#   https://gramine.readthedocs.io/en/stable/manifest-syntax.html#number-of-threads
sgx.max_threads = 16
